From 6b7687433bbdc76179c92d28f0fd1a901977d110 Mon Sep 17 00:00:00 2001
From: vlc-sftp <vlc-sftp@local>
Date: Sun, 30 Aug 2026 10:57:25 +0000
Subject: [PATCH] buildsystem: keep -lgpg-error in the libvlc.so link line

The contrib link flags come from `pkg-config --libs` over every .pc in the
contrib prefix.  gcrypt.pc only yields -lgcrypt because libgpg-error sits in
Requires.private, which is ignored without --static.  Once libssh2 uses the
Mbed TLS backend, nothing else asks for -lgpg-error any more, so libvlc.so
still linked -lgcrypt without its dependency and ld.lld failed with
"undefined symbol: gpgrt_fclose".  Append it after -lgcrypt, the only
position that resolves libgcrypt's references in a static link.

Message-Id: <0004-libvlcjni-gpg-error-link@arena.local>
---
 buildsystem/compile-libvlc.sh | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/buildsystem/compile-libvlc.sh b/buildsystem/compile-libvlc.sh
index f9c4a17..feb1087 100644
--- a/buildsystem/compile-libvlc.sh
+++ b/buildsystem/compile-libvlc.sh
@@ -722,6 +722,17 @@ rm ${REDEFINED_VLC_MODULES_DIR}/syms
 
 VLC_MODULES=$(avlc_find_modules ${REDEFINED_VLC_MODULES_DIR})
 VLC_CONTRIB_LDFLAGS=$(cd $VLC_CONTRIB/lib/pkgconfig; avlc_pkgconfig --libs $(ls *.pc  | sed -e 's/\.pc$//' | xargs))
+# VLC-SFTP-FIX: la liste ci-dessus vient de pkg-config sur les .pc du prefix des contribs,
+# et gcrypt.pc n'y fait entrer que -lgcrypt : sa dependance libgpg-error est declaree en
+# Requires.private, donc ignoree sans --static. Quand libssh2 est bascule cote Mbed TLS, plus
+# rien ne reclame -lgpg-error et libvlc.so garde -lgcrypt sans sa dependance ->
+# "ld.lld: error: undefined symbol: gpgrt_fclose" (mesure: 359 options -l, -lgcrypt en #297,
+# -lgpg-error absente, alors que libgpg-error.a est installe). On la rajoute apres, seule
+# position qui resout les references de libgcrypt.a en liaison statique. Idempotent.
+case " $VLC_CONTRIB_LDFLAGS " in
+    *" -lgpg-error "*) ;;
+    *) VLC_CONTRIB_LDFLAGS="$VLC_CONTRIB_LDFLAGS -lgpg-error" ;;
+esac
 
 echo -e "ndk-build vlc"
 
-- 
